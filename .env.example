# SQLite 数据库文件位置（Docker 中映射到挂载卷 ./data）
DATABASE_URL="file:./dev.db"

# 会话签名密钥（务必改为随机长字符串：openssl rand -base64 48）
AUTH_SECRET="change-me-to-a-long-random-secret"

# 是否给会话 cookie 加 Secure 标志：配了 HTTPS 才设 true；
# 纯 HTTP 部署必须 false，否则登录无法保持。
COOKIE_SECURE="false"

# 初始管理员（仅首次 seed 时生效）
ADMIN_EMAIL="admin@leublog.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme123"
ADMIN_DISPLAY_NAME="站长"

# 站点基本信息（也可后台修改）
SITE_NAME="LeuBlog"
