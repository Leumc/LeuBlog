// LeuBlog 数据模型（SQLite + Prisma）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum AnnouncementLevel {
  info
  warn
}

enum PortalPlacement {
  sidebar
  footer
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  displayName  String
  bio          String?
  avatar       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts         Post[]
  announcements Announcement[]
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String     // markdown 原文
  excerpt     String?
  coverImage  String?
  status      PostStatus @default(DRAFT)
  viewCount   Int        @default(0)
  locked      Boolean    @default(false)
  gateNote    String?    // 解锁界面展示的文章级说明
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tags       Tag[]     @relation("PostTags")
  accessKeys AccessKey[] @relation("KeyPosts")
  mediaReferences MediaReference[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
}

// 文章分组（一级）
model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())

  posts     Post[]
  tagGroups TagGroup[]
}

// 标签组（二级，归属某文章分组）
model TagGroup {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags       Tag[]

  @@index([categoryId])
}

// 标签（三级，可选归属某标签组）
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  tagGroupId String?
  tagGroup   TagGroup? @relation(fields: [tagGroupId], references: [id], onDelete: SetNull)
  posts      Post[]    @relation("PostTags")

  @@index([tagGroupId])
}

model Announcement {
  id        String            @id @default(cuid())
  content   String
  level     AnnouncementLevel @default(info)
  active    Boolean           @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime          @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([active])
}

model Portal {
  id          String          @id @default(cuid())
  title       String
  url         String
  description String?
  icon        String?
  group       String          @default("友链")
  placement   PortalPlacement @default(sidebar)
  order       Int             @default(0)
  visible     Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@index([placement, visible])
}

// key-value 站点设置
model SiteSetting {
  key   String @id
  value String
}

// 按天聚合的访问量；postId=null 表示全站
model DailyView {
  id     String   @id @default(cuid())
  date   String   // YYYY-MM-DD（本地日）
  postId String?
  count  Int      @default(0)

  @@unique([date, postId])
  @@index([postId])
  @@index([date])
}

// 文章访问许可密钥
model AccessKey {
  id         String    @id @default(cuid())
  label      String?   // 后台备注名
  secretEnc  String    // AES-256-GCM 加密后的密钥明文
  note       String?   // 密钥级说明（解锁成功后展示）
  maxUses    Int?      // 最大使用次数，null=不限
  usedCount  Int       @default(0)
  validUntil DateTime? // 有效截止，null=不过期
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  posts Post[] @relation("KeyPosts")

  @@index([active])
}

// 媒体库文件夹；显示名在此表，随机物理目录段在 MediaStorageFolder。
model MediaCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   MediaCategory?  @relation("MediaCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaCategory[] @relation("MediaCategoryTree")
  assets   MediaAsset[]
  storage  MediaStorageFolder?

  @@unique([parentId, name])
  @@index([parentId])
}

// 图片的可变展示信息；filename 是随机实际文件名，相对路径由 MediaStorageAsset 保存。
model MediaAsset {
  id          String   @id @default(cuid())
  filename    String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   MediaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  storage    MediaStorageAsset?
  references MediaReference[]

  @@index([categoryId])
}

// 文件夹显示名与磁盘随机目录段分离，兼容已经存在的 MediaCategory 表。
model MediaStorageFolder {
  categoryId String @id
  storageName String @unique
  category MediaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// 图片当前实际相对路径；旧图片没有记录时回退到 MediaAsset.filename（上传根目录）。
model MediaStorageAsset {
  assetId      String @id
  relativePath String @unique
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// 可查询的文章图片引用索引；正文仍是最终内容来源。
model MediaReference {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  assetId   String
  postId    String
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([assetId, postId])
  @@index([postId])
}
